# ╔══════════════════════════════════════════════════════════════════════════╗
# ║           LexGuard — Environment Configuration                           ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# Copy to .env and fill in your values.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choices: auto | vertex | gemini | openrouter
# auto priority: vertex (GCP) → gemini → openrouter
LLM_PROVIDER=auto

# Google Gemini (direct API — get key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (alternative — get key from https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── Google Cloud Platform ─────────────────────────────────────────────────────
# Set GOOGLE_CLOUD_PROJECT to enable: Vertex AI, Firestore, Cloud Storage, Vision
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# Path to Service Account JSON key (not needed on Cloud Run — uses Workload Identity)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Vertex AI (enterprise Gemini — used automatically when GOOGLE_CLOUD_PROJECT is set)
VERTEX_MODEL=gemini-2.0-flash
VERTEX_EMBED_MODEL=textembedding-gecko@003

# Cloud Storage bucket (stores uploaded contracts; falls back to local /tmp if not set)
GCS_BUCKET_NAME=

# Firestore (stores analysis results; falls back to MongoDB, then in-memory)
FIRESTORE_COLLECTION=lexguard_documents

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB URI (used as fallback if Firestore is not configured)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=lexguard

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=/tmp/uploads

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
PORT=8080
